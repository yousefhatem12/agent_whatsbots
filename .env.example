# Server
PORT=8000

# LLM Provider Configuration ("openai" or "deepseek")
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
# LLM_API_KEY=
# LLM_BASE_URL=

# OpenAI Fallback / Direct Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=

# DeepSeek Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=disabled

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=real_estate_db
# Optional full SQLAlchemy URL override:
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/real_estate_db?charset=utf8mb4

